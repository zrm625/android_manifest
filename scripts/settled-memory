#!/usr/bin/env bash
# Record a settled RAM sample on an already configured river trial.
set -euo pipefail

if (( $# < 1 || $# > 2 )) || [[ ${2:-1} != 1 && ${2:-1} != 3 ]]; then
  echo "Usage: settled-memory OUTPUT_DIR [1|3]" >&2
  exit 1
fi
source "$(dirname "$(realpath "$0")")/common.sh"
device_lock

out=$1 samples=${2:-1}
serial=ZY225DPT7F
fail() { echo "error: $*" >&2; exit 1; }
phone() { timeout --foreground -k 10 120 adb -s "$serial" shell "$@" | tr -d '\r'; }

[[ $(phone getprop ro.product.device) == river ]] || fail "the test phone is not river"
[[ $(phone getprop ro.serialno) == "$serial" ]] || fail "the phone did not report serial $serial"
[[ $(phone getprop sys.boot_completed) == 1 ]] || fail "Android has not completed boot"
[[ $(phone settings get global device_provisioned) == 1 ]] || fail "run phone-setup first"

boot_id=$(phone cat /proc/sys/kernel/random/boot_id)
[[ -n "$boot_id" ]] || fail "cannot read the boot ID"
build_id=$(phone getprop ro.river.build_id)
case "$(phone getprop ro.config.low_ram)" in
  1|y|yes|on|true) low_ram=true ;;
  *) low_ram=false ;;
esac
stay_on=$(phone settings get global stay_on_while_plugged_in)
[[ "$stay_on" == null || "$stay_on" =~ ^[0-9]+$ ]] || fail "cannot read stay-on setting"

restore_stay_on() {
  if [[ "$stay_on" == null ]]; then
    phone settings delete global stay_on_while_plugged_in >/dev/null
  else
    phone settings put global stay_on_while_plugged_in "$stay_on" >/dev/null
  fi
}

check_home() {
  local foreground power
  foreground=$(phone dumpsys activity activities)
  power=$(phone dumpsys power)
  grep -Eiq '(mResumedActivity|topResumedActivity).*app\.zak\.perch/' <<<"$foreground" ||
    fail "Perch is not in the foreground"
  grep -q 'mWakefulness=Awake' <<<"$power" || fail "the display is asleep"
}

mkdir -p "$out"
rm -f "$out/post-setup-used-ram-kb.txt"
: > "$out/post-setup-ram-samples-kb.txt"
trap restore_stay_on EXIT
phone settings put global stay_on_while_plugged_in 7
phone input keyevent KEYCODE_WAKEUP
phone input keyevent KEYCODE_HOME
sleep 2
check_home

echo "Settling on Perch for five minutes"
sleep 300
for ((sample=1; sample<=samples; sample++)); do
  [[ $(phone cat /proc/sys/kernel/random/boot_id) == "$boot_id" ]] || fail "the phone rebooted while settling"
  check_home
  meminfo="$out/post-setup-meminfo.txt"
  if (( sample > 1 )); then
    meminfo="$out/post-setup-meminfo-$sample.txt"
  fi
  phone dumpsys meminfo > "$meminfo"
  ram_kb=$(awk -F: '/^[[:space:]]*Used RAM:/ {
    sub(/^[[:space:]]*/, "", $2)
    split($2, fields, "K")
    gsub(/[[:space:],]/, "", fields[1])
    print fields[1]
    exit
  }' "$meminfo")
  [[ "$ram_kb" =~ ^[0-9]+$ ]] || fail "dumpsys meminfo did not report Used RAM"
  [[ $(phone cat /proc/sys/kernel/random/boot_id) == "$boot_id" ]] || fail "the phone rebooted while sampling"
  check_home
  printf '%s\n' "$ram_kb" >> "$out/post-setup-ram-samples-kb.txt"
  printf 'Used RAM after setup, sample %d: %s KiB\n' "$sample" "$ram_kb"
  if (( sample < samples )); then sleep 30; fi
done
phone ip -4 -o addr show wlan0 > "$out/post-setup-wlan0.txt"
printf 'build=%s\nboot_id=%s\nlow_ram=%s\ncaptured_at=%s\n' \
  "$build_id" "$boot_id" "$low_ram" "$(date -Iseconds)" > "$out/post-setup-state.txt"
sort -n "$out/post-setup-ram-samples-kb.txt" | sed -n "$((samples / 2 + 1))p" > "$out/post-setup-used-ram-kb.txt"

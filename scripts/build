#!/usr/bin/env bash
# Build the ROM for day-to-day work. Incremental: keeps the previous output, so
# after a small change only what depends on it is rebuilt, in minutes rather
# than hours.
#
# Usage: build [--tree baseline|stripped] [--installclean] [--clean] [--ccache] [--jobs N] [--target T]
#              [--build-id ID | --batch ID]
#
#   --tree     Which tree to build. Default: stripped (this tree).
#   --installclean  Delete the staged partitions and images first, but keep
#              compiled objects. Use it after removing packages, blobs or
#              features: an incremental build can leave removed files behind,
#              and they end up in the image. Costs a few extra minutes.
#   --clean    Delete the previous output first. Rarely needed; try without it.
#   --ccache   Use the shared ccache in $BENCH_HOME/ccache. It only pays off when
#              the output is deleted often. Switching it on or off changes every
#              C/C++ compile command, so the next build recompiles all C/C++ once.
#              Pick one setting per output directory and keep it.
#   --jobs N   Parallel jobs. Default: nproc.
#   --target T Build target. Default: bacon (flashable images and zip).
#   --build-id ID  Stamp: written to ro.river.build_id (/system/build.prop) and
#              ro.vendor.river.build_id (/vendor/build.prop), which phone-qa
#              checks. Letters, digits, '.', '_' and '-' only. A batch build
#              passes "<batch id>-<commit set hash>". Default: $RIVER_BUILD_ID
#              if set, otherwise "dev-<time>-<commit set hash>".
#   --batch ID Build for batch ID: the build ID is "ID-<commit set hash>", which
#              is what phone-qa stage requires of a batch. Refuses a dirty tree.
#
# Output goes to $BENCH_HOME/out-<tree>/, which is what scripts/flash installs.
# A successful build also writes out-<tree>/river-build.json: the build ID and
# the commit set (each fork's HEAD and the manifest's) it was built from.
# For timing measurements, use scripts/bench/bench instead: it builds cold in a
# separate directory and never touches this output.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/bench/lib.sh"

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

env_name=stripped installclean=0 clean=0 ccache=0 jobs=$(nproc) target=bacon build_id=${RIVER_BUILD_ID:-} batch=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tree) env_name=$2; shift ;;
    --installclean) installclean=1 ;;
    --clean) clean=1 ;;
    --ccache) ccache=1 ;;
    --jobs) jobs=$2; shift ;;
    --target) target=$2; shift ;;
    --build-id) build_id=$2; shift ;;
    --batch) batch=$2; shift ;;
    -h|--help) usage 0 ;;
    *) echo "unknown option: $1" >&2; usage 1 ;;
  esac
  shift
done
tree=$(tree_for "$env_name") || usage 1
[[ -d "$tree/.repo" ]] || { echo "error: no repo tree at $tree" >&2; exit 1; }

# The commit set: one "<path> <sha>" line per fork in byte order, plus the
# manifest. A dirty repo, the manifest included, gets "+dirty", so an
# uncommitted build never looks committed. Untracked files count too: an
# untracked build input changes the build without changing HEAD. phone-qa
# recomputes the hash (qa/lib/riverqa/stage.py, commit_set_hash), so keep the
# format in step.
dirty() { [[ -n "$(git -C "$1" status --porcelain)" ]] && echo +dirty || true; }
commit_set() {
  local path
  { (cd "$tree" && "$REPO" forall -g "$FORK_GROUP" -c 'echo "$REPO_PATH"' 2>/dev/null) || true; } |
    while read -r path; do
      printf '%s %s%s\n' "$path" "$(git -C "$tree/$path" rev-parse HEAD)" "$(dirty "$tree/$path")"
    done | LC_ALL=C sort
  printf '.repo/manifests %s%s\n' "$(git -C "$tree/.repo/manifests" rev-parse HEAD)" "$(dirty "$tree/.repo/manifests")"
}
commits=$(commit_set)
commit_hash=$(sha256sum <<<"$commits" | cut -c1-10)
if [[ -n "$batch" ]]; then
  [[ "$commits" != *+dirty* ]] || { echo "error: --batch needs a clean tree; dirty: $(grep -F +dirty <<<"$commits" | cut -d' ' -f1 | tr '\n' ' ')" >&2; exit 1; }
  build_id="$batch-$commit_hash"
fi
[[ -n "$build_id" ]] || build_id="dev-$(date +%Y%m%d-%H%M%S)-$commit_hash"
[[ "$build_id" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || { echo "error: bad build ID '$build_id'" >&2; exit 1; }
export RIVER_BUILD_ID=$build_id

acquire_build_lock
# Lowest CPU priority: the build and every compiler it starts yield to
# anything interactive, but still use idle cores. (bench does not do this, so
# its timings are not affected by the desktop.)
renice -n 19 $$ >/dev/null
ensure_image
out=$BENCH_HOME/out-$env_name
mkdir -p "$out" "$BENCH_HOME/logs"
if [[ "$clean" == 1 ]]; then
  echo "Deleting $out"
  find "$out" -mindepth 1 -delete
fi

log=$BENCH_HOME/logs/build-$(date +%Y%m%d-%H%M%S)-$env_name.log
echo "Building $target for $env_name into $out, build ID $build_id (log: $log)"
rc=0
run_build "$tree" "$out" "$target" "$jobs" "$ccache" "$log" "$installclean" || rc=$?
read -r _ wall _ < <(cat "$out/.bench-result" 2>/dev/null || echo "$rc 0 ")
echo
if [[ "$rc" == 0 ]]; then
  python3 -I -c '
import json, sys
build_id, commit_hash, commits, out = sys.argv[1:5]
rows = [l.split(" ", 1) for l in commits.splitlines() if l.strip()]
json.dump({"build_id": build_id, "commit_set_hash": commit_hash,
           "commit_set": {p: s for p, s in rows}}, open(out, "w"), indent=2)
' "$build_id" "$commit_hash" "$commits" "$out/river-build.json"
  echo "Built $build_id in ${wall}s. Install with: scripts/flash $env_name"
else
  echo "Build failed (exit $rc). Log: $log"
fi
exit "$rc"

#!/usr/bin/env bash
# Manage one change that spans several zrm625 repos as a single unit: one
# branch name in every repo, one command to open all the pull requests, one
# command to merge them together.
#
# Usage:
#   change start NAME            Create branch NAME from river-22.2 in every fork
#                                and in the manifest, and check it out.
#   change status [NAME]         Per repo: commits on NAME, uncommitted files, PR.
#   change pr [NAME] -t TITLE [-b BODY | -F FILE]
#                                Push NAME in every repo that has commits on it,
#                                open or update a PR there (base river-22.2),
#                                and list all the PRs of the change in each one.
#   change merge NAME --record FILE
#                                Merge a council-reviewed, tooling-only manifest
#                                PR at its reviewed head (qa/RUNNER.md R5.8, H4).
#                                Refused without --record, for any fork PR, and
#                                for any path outside qa/, scripts/, workspace/
#                                and *.md other than CHARTER.md. Image changes
#                                never merge here: they end at `batch enqueue`.
#   change tag TAG [-m MESSAGE]  Tag river-22.2 in every repo as TAG and push it.
#
# NAME defaults to the topic branch checked out in the repos, if there is
# exactly one. Repos are the forks in the zrm625-fork group plus the manifest
# (.repo/manifests). Commit in each repo as usual; this script only handles
# branches, pull requests and merges. It never pushes to river-22.2 directly.
#
# start, pr, merge and tag take the build lock for their whole run (busy: exit
# 1, "a build or batch is running") and refuse while the batch runner has a
# batch running or a tree lease (qa/RUNNER.md R6.5). So `change pr` never
# pushes to a branch while a batch runs.
set -euo pipefail
source "$(dirname "$(realpath "$0")")/common.sh"

# Pushing to the blob repos needs git-lfs.
[[ -x "$TOP/.repo-bootstrap/bin/git-lfs" ]] && PATH="$TOP/.repo-bootstrap/bin:$PATH"

# gh, without the event-subscription hints it prints after PR commands.
ghq() { gh "$@" 2> >(grep -vE '^(hint: if you need to wait|    gh event listen|  - )' >&2); }

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
die() { echo "error: $*" >&2; exit 1; }

# One line per repo: <path> <remote> <local base branch> <owner/repo>
repos() {
  local path
  while read -r path; do
    echo "$TOP/$path $FORK_REMOTE $FORK_BRANCH $(slug "$TOP/$path" "$FORK_REMOTE")"
  done < <(cd "$TOP" && "$REPO" forall -g "$FORK_GROUP" -c 'echo "$REPO_PATH"' 2>/dev/null | sort)
  echo "$TOP/.repo/manifests origin default $(slug "$TOP/.repo/manifests" origin)"
}
slug() { git -C "$1" remote get-url "$2" | sed -E 's#^(https://github.com/|git@github.com:)##; s#\.git$##'; }
short() { local p=${1#"$TOP/"}; echo "${p:-.}"; }

# The change name: given, or the one topic branch checked out across the repos.
resolve_name() {
  if [[ -n "${1:-}" ]]; then echo "$1"; return; fi
  local names
  names=$(repos | while read -r path _ base _; do
    b=$(git -C "$path" symbolic-ref --short -q HEAD || true)
    [[ -n "$b" && "$b" != "$base" && "$b" != "$FORK_BRANCH" ]] && echo "$b"
  done | sort -u)
  [[ $(grep -c . <<<"$names") == 1 ]] || die "cannot tell which change you mean (topic branches checked out: ${names//$'\n'/, }). Pass NAME."
  echo "$names"
}

ahead() { git -C "$1" rev-list --count "$2/$FORK_BRANCH..$3" 2>/dev/null || echo 0; }
has_branch() { git -C "$1" show-ref --verify -q "refs/heads/$2"; }
pr_json() { ghq pr list --repo "$1" --head "$2" --state all --json number,state,url,mergeable --jq "${3:-.}" 2>/dev/null; }

cmd_start() {
  local name=${1:-}; [[ -n "$name" ]] || usage 1
  [[ "$name" != "$FORK_BRANCH" && "$name" != default ]] || die "pick a topic branch name"
  repos | while read -r path remote base slug; do
    git -C "$path" fetch -q "$remote" "$FORK_BRANCH"
    if has_branch "$path" "$name"; then
      git -C "$path" checkout -q "$name"
    else
      git -C "$path" checkout -q -b "$name" "$remote/$FORK_BRANCH"
    fi
    git -C "$path" branch -q --set-upstream-to="$remote/$FORK_BRANCH" "$name"
    printf '  %-34s on %s\n' "$(short "$path")" "$name"
  done
  echo "Commit in any of these repos, then: change pr -t \"<title>\""
}

cmd_status() {
  local name; name=$(resolve_name "${1:-}")
  echo "Change: $name"
  repos | while read -r path remote base slug; do
    has_branch "$path" "$name" || continue
    local n dirty cur pr
    n=$(ahead "$path" "$remote" "$name")
    dirty=$(git -C "$path" status --porcelain | grep -c . || true)
    cur=$(git -C "$path" symbolic-ref --short -q HEAD || echo detached)
    pr=$(pr_json "$slug" "$name" '.[0] | select(.) | "\(.state) \(.url)"')
    [[ "$n" == 0 && "$dirty" == 0 && -z "$pr" ]] && continue
    printf '  %-34s %2s commits%s%s  %s\n' "$(short "$path")" "$n" \
      "$( [[ "$dirty" != 0 ]] && echo ", $dirty uncommitted" )" \
      "$( [[ "$cur" != "$name" ]] && echo ", checked out: $cur" )" "${pr:-no PR}"
  done
}

cmd_pr() {
  local name="" title="" body=""
  [[ $# -gt 0 && "$1" != -* ]] && { name=$1; shift; }
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--title) title=$2; shift ;;
      -b|--body) body=$2; shift ;;
      -F|--body-file) body=$(cat "$2"); shift ;;
      *) usage 1 ;;
    esac
    shift
  done
  name=$(resolve_name "$name")
  local list; list=$(mktemp); trap 'rm -f "$list"' RETURN

  # Push and create or update one PR per repo with commits.
  while read -r path remote base slug; do
    has_branch "$path" "$name" || continue
    [[ "$(ahead "$path" "$remote" "$name")" != 0 ]] || continue
    [[ -z "$(git -C "$path" status --porcelain)" ]] || echo "warning: $(short "$path") has uncommitted changes; they are not in the PR" >&2
    git -C "$path" push -q --force-with-lease "$remote" "$name:$name" 2> >(grep -v '^remote:' >&2)
    local url; url=$(pr_json "$slug" "$name" '[.[] | select(.state == "OPEN")][0].url // empty')
    if [[ -z "$url" ]]; then
      [[ -n "$title" ]] || die "no PR yet in $slug: pass -t TITLE"
      url=$(ghq pr create --repo "$slug" --base "$FORK_BRANCH" --head "$name" --title "$title" --body "(change set: $name)" 2>/dev/null | grep -E '^https://')
      echo "  opened  $url"
    else
      [[ -n "$title" ]] && ghq pr edit "$url" --title "$title" >/dev/null
      echo "  updated $url"
    fi
    echo "$path $remote $url" >> "$list"
  done < <(repos)
  [[ -s "$list" ]] || die "no repo has commits on $name"

  # Every PR gets the shared description, its own commits, and the full set.
  local set=""; while read -r _ _ url; do set+="- $url"$'\n'; done < "$list"
  while read -r path remote url; do
    local commits; commits=$(git -C "$path" log --reverse --format='- %s' "$remote/$FORK_BRANCH..$name")
    local text
    text="${body:+$body

}## Commits in this repo
$commits

## Change set \`$name\`
Merge these together with \`.repo/manifests/scripts/change merge $name\`:
${set//$url/$url (this PR)}"
    if [[ -z "$body" ]]; then
      # Keep a description written earlier; replace only the generated part.
      local old; old=$(ghq pr view "$url" --json body --jq .body | sed '/^## Commits in this repo$/,$d' | sed '/^(change set: .*)$/d')
      old=$(sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' <<<"$old")
      text="${old:+$old

}${text}"
    fi
    ghq pr edit "$url" --body "$text" >/dev/null
  done < "$list"
  echo "Merge them all with: change merge $name"
}

cmd_merge() {
  local name="" record=""
  [[ $# -gt 0 && "$1" != -* ]] && { name=$1; shift; }
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --record) record=$2; shift ;;
      *) usage 1 ;;
    esac
    shift
  done
  # G-C2: without a council record nothing merges here, in any repo.
  [[ -n "$record" ]] || die "change merge needs --record FILE: it merges only a council-reviewed, tooling-only manifest PR. Image changes go through the council and \`batch enqueue\`."
  [[ -n "$name" ]] || die "change merge NAME --record FILE: pass NAME"
  python3 -I "$QA_LIB/riverbatch/tooling.py" "$name" "$record" || die "nothing merged."
  local m="$TOP/.repo/manifests"
  git -C "$m" fetch -q origin "$FORK_BRANCH"
  if [[ "$(git -C "$m" symbolic-ref --short -q HEAD || true)" == "$name" ]]; then
    git -C "$m" checkout -q default
  fi
  if [[ "$(git -C "$m" symbolic-ref --short -q HEAD || true)" == default && -z "$(git -C "$m" status --porcelain)" ]]; then
    git -C "$m" merge -q --ff-only "origin/$FORK_BRANCH" || true
  fi
  git -C "$m" branch -q -D "$name" 2>/dev/null || true
  echo "Done. The tooling PR is merged; qualify the harness or the runner again as qa/RUNNER.md R14.4 says."
}

cmd_tag() {
  local tag=${1:-} msg=""; shift || true
  [[ -n "$tag" ]] || usage 1
  [[ "${1:-}" == -m ]] && msg=$2
  repos | while read -r path remote base slug; do
    git -C "$path" fetch -q "$remote" "$FORK_BRANCH"
    git -C "$path" tag -a "$tag" -m "${msg:-$tag}" "$remote/$FORK_BRANCH"
    git -C "$path" push -q "$remote" "refs/tags/$tag"
    printf '  %-34s %s at %s\n' "$(short "$path")" "$tag" "$(git -C "$path" rev-parse --short "$remote/$FORK_BRANCH")"
  done
}

sub=${1:-}; shift || true
case "$sub" in
  start|pr|merge|tag)
    # H4: one build lock for the whole run, around every repo forall; and
    # nothing while a batch runs or holds the tree.
    acquire_build_lock
    refuse_while_batch ;;
esac
case "$sub" in
  start) cmd_start "$@" ;;
  status) cmd_status "$@" ;;
  pr) cmd_pr "$@" ;;
  merge) cmd_merge "$@" ;;
  tag) cmd_tag "$@" ;;
  -h|--help|help) usage 0 ;;
  *) usage 1 ;;
esac

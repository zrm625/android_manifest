#!/usr/bin/env bash
# Check that the build on the Moto G7 test phone works: run it after every flash.
#
# Usage: phone-check [--wait] [--cameras N]
#
#   --wait       Wait up to 15 minutes for the phone to finish booting first.
#   --cameras N  Number of cameras to expect. Default: 3 (river).
#
# Checks: the phone runs the build in $BENCH_HOME/out-stripped, boot finished,
# SELinux enforcing, no crashes or tombstones since boot, no services crashing
# or restarting in a loop, Wi-Fi connected with internet, Bluetooth on, GPS
# (GNSS HAL), cameras, sensors, fingerprint, audio, and no telephony features.
# Prints one line per check. Exits 1 if any check fails. WARN lines need a look
# but do not fail the run (for example, Wi-Fi not set up after a wipe).
#
# Only the phone with serial $BENCH_DEVICE (default ZY225DPT7F) is touched.
set -euo pipefail

BENCH_HOME=${BENCH_HOME:-/mnt/storage/lineageos-bench}
SERIAL=${BENCH_DEVICE:-ZY225DPT7F}
DEVICE_CODENAME=river

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

wait_boot=0 cameras=3
while [[ $# -gt 0 ]]; do
  case "$1" in
    --wait) wait_boot=1 ;;
    --cameras) cameras=$2; shift ;;
    -h|--help) usage 0 ;;
    *) echo "unknown option: $1" >&2; usage 1 ;;
  esac
  shift
done

a() { adb -s "$SERIAL" "$@"; }
# Read the whole output before filtering: closing a dumpsys pipe early sends
# SIGPIPE to the service being dumped (it killed the camera HAL once).
sh_() { a shell "$@" 2>/dev/null | tr -d '\r'; }

fails=0 warns=0
pass() { printf '  PASS  %-12s %s\n' "$1" "$2"; }
warn() { printf '  WARN  %-12s %s\n' "$1" "$2"; warns=$((warns + 1)); }
fail() { printf '  FAIL  %-12s %s\n' "$1" "$2"; fails=$((fails + 1)); }

state=$(a get-state 2>/dev/null || true)
[[ "$state" == device ]] || { echo "error: $SERIAL is not connected in adb device mode (state: ${state:-none})" >&2; exit 1; }
codename=$(sh_ getprop ro.product.device)
[[ "$codename" == "$DEVICE_CODENAME" ]] || { echo "error: $SERIAL is '$codename', not $DEVICE_CODENAME. Refusing." >&2; exit 1; }

if [[ "$wait_boot" == 1 ]]; then
  deadline=$((SECONDS + 900))
  until [[ "$(sh_ getprop sys.boot_completed)" == 1 ]]; do
    (( SECONDS < deadline )) || break
    sleep 2
  done
fi
a root >/dev/null 2>&1 || true
a wait-for-device

echo "Phone $SERIAL: $(sh_ getprop ro.lineage.display.version), slot $(sh_ getprop ro.boot.slot_suffix)"

# Build
phone_date=$(sh_ getprop ro.build.date.utc)
built_date=$(grep -m1 '^ro.build.date.utc=' "$BENCH_HOME/out-stripped/target/product/river/system/build.prop" 2>/dev/null | cut -d= -f2 || true)
if [[ -n "$built_date" && "$phone_date" == "$built_date" ]]; then
  pass build "runs the latest build in out-stripped ($(date -d "@$phone_date" '+%F %R'))"
else
  warn build "phone build $(date -d "@${phone_date:-0}" '+%F %R'), out-stripped build $( [[ -n "$built_date" ]] && date -d "@$built_date" '+%F %R' || echo none). Not flashed yet?"
fi

[[ "$(sh_ getprop sys.boot_completed)" == 1 ]] && pass boot "finished (uptime $(sh_ cat /proc/uptime | awk '{printf "%d", $1}')s)" || fail boot "not finished (try --wait)"
[[ "$(sh_ getenforce)" == Enforcing ]] && pass selinux enforcing || fail selinux "$(sh_ getenforce)"

# Crashes since boot
crash=$(sh_ logcat -b crash -d)
procs=$(grep -oE 'Process: [^,]+' <<<"$crash" | sort | uniq -c | sort -rn | awk '{print $3" x"$1}' | paste -sd' ' || true)
[[ -z "$procs" ]] && pass crashes "none since boot" || fail crashes "$procs"
tomb=$(sh_ 'ls /data/tombstones 2>/dev/null' | grep -c '^tombstone' || true)
[[ "$tomb" == 0 ]] && pass tombstones none || warn tombstones "$tomb in /data/tombstones (may be from before this boot)"

# Services: crash signals and restart loops (SIGKILL is normal for lazy HALs).
dmesg_out=$(sh_ dmesg)
bad_sig=$(grep -oE "init: Service '[^']+' \(pid [0-9]+\) received signal (4|6|7|8|11)" <<<"$dmesg_out" | sed -E "s/init: Service '([^']+)'.*signal ([0-9]+)/\1 (signal \2)/" | sort -u | paste -sd' ' || true)
# A death right after "ctl.stop" was asked for on purpose (Overlay Manager stops
# idmap2d 10 s after each use, for example), so it is not a restart.
loops=$(sed -nE "s/.*Processed ctl\.stop for '([^']+)'.*/STOP \1/p; s/.*init: Service '([^']+)' \(pid [0-9]+\) (exited|received signal).*/DIED \1/p" <<<"$dmesg_out" |
  awk '$1 == "STOP" {stopped[$2] = 1; next} stopped[$2] {stopped[$2] = 0; next} {n[$2]++}
       END {for (s in n) if (n[s] >= 3) print s " x" n[s]}' | sort | paste -sd' ' || true)
if [[ -n "$bad_sig" ]]; then fail services "crashed: $bad_sig"
elif [[ -n "$loops" ]]; then fail services "restarting: $loops"
else pass services "no crashes or restart loops"
fi

# Wi-Fi
wifi=$(sh_ cmd wifi status)
if grep -q 'Wifi is connected to' <<<"$wifi"; then
  ssid=$(grep -m1 -oE 'Wifi is connected to "[^"]*"' <<<"$wifi" | sed 's/.*to //')
  if sh_ ping -c2 -W3 1.1.1.1 | grep -q ' 0% packet loss'; then pass wifi "connected to $ssid, internet OK"
  else fail wifi "connected to $ssid but no internet"
  fi
elif grep -q 'Wifi is enabled' <<<"$wifi"; then warn wifi "enabled, not connected (set up a network on the phone)"
else fail wifi "disabled or broken"
fi

# Bluetooth
bt=$(sh_ dumpsys bluetooth_manager)
grep -qE '^ *state: ON' <<<"$bt" && pass bluetooth on || warn bluetooth "not on (turn it on in quick settings, then rerun)"

# GPS: the GNSS HAL reports the modem firmware when it is up.
loc=$(sh_ dumpsys location)
gnss=$(grep -m1 -oE 'GNSS Hardware Model Name: .*' <<<"$loc" | sed 's/GNSS Hardware Model Name: //' || true)
[[ -n "$gnss" ]] && pass gps "GNSS HAL up ($gnss)" || fail gps "no GNSS HAL"

# Cameras
cam=$(sh_ dumpsys media.camera)
ncam=$(grep -m1 -oE 'Number of camera devices: [0-9]+' <<<"$cam" | grep -oE '[0-9]+$' || echo 0)
[[ "$ncam" == "$cameras" ]] && pass cameras "$ncam" || fail cameras "$ncam, expected $cameras"

# Sensors, fingerprint, audio
sensors=$(sh_ dumpsys sensorservice)
nsens=$(grep -m1 -oE 'Total [0-9]+ h/w sensors' <<<"$sensors" | grep -oE '[0-9]+' || echo 0)
(( nsens > 0 )) && pass sensors "$nsens hardware sensors" || fail sensors "none"
fp=$(sh_ dumpsys fingerprint)
grep -q 'FingerprintProvider' <<<"$fp" && pass fingerprint "HAL up" || fail fingerprint "no fingerprint HAL"
audio=$(sh_ dumpsys media.audio_flinger)
grep -q 'Output thread' <<<"$audio" && pass audio "output streams open" || fail audio "no audio output"

# Wi-Fi-only build: the phone must not claim telephony.
tel=$(sh_ pm list features | grep -c 'telephony' || true)
[[ "$tel" == 0 ]] && pass telephony "no telephony features (Wi-Fi only)" || warn telephony "$tel telephony features declared"

echo
if (( fails > 0 )); then echo "$fails failed, $warns warnings"; exit 1; fi
(( warns > 0 )) && echo "All checks passed, $warns warnings" || echo "All checks passed"

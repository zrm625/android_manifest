<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to the host test server: over adb reverse (127.0.0.1) and
     on forge's LAN address, filled in at build time (part of the cache key). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">@LAN_ADDR@</domain>
    </domain-config>
</network-security-config>
